<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceCraft.Client.ViewModels"
             xmlns:locale="using:VoiceCraft.Client.Locales"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VoiceCraft.Client.Views.HostServerConsoleView"
             x:DataType="vm:HostServerConsoleViewModel">
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0"
              Margin="0,0,0,10"
              Background="{DynamicResource BackgroundBrush}">
            <TextBlock Margin="10"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="{locale:Localize HostServerConsole.Title}"
                       TextAlignment="Center" />
            <Button Padding="10"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Command="{Binding CancelCommand}"
                    CornerRadius="0">
                <PathIcon Data="{DynamicResource ArrowLeftRegular}" />
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Padding="15"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Classes="card"
                Margin="10,0,10,10">
            <ScrollViewer>
                <TextBlock FontFamily="{StaticResource Hack-Regular}"
                           Text="{Binding Output}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>