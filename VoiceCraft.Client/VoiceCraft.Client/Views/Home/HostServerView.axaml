<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VoiceCraft.Client.Views.Home.HostServerView"
             xmlns:locale="clr-namespace:VoiceCraft.Client.Locales"
             xmlns:vm="clr-namespace:VoiceCraft.Client.ViewModels.Home"
             x:DataType="vm:HostServerViewModel">
    <Panel>
        <Border Padding="15"
                VerticalAlignment="Top"
                Classes="card">
            <Button HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Command="{Binding StartServerCommand}">
                <TextBlock Text="{locale:Localize Host.Title}" TextAlignment="Center" />
            </Button>
        </Border>
    </Panel>
</UserControl>